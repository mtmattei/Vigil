<Page x:Class="Vigil.Presentation.RecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:local="using:Vigil.Presentation"
      xmlns:controls="using:Vigil.Controls"
      Background="{ThemeResource BackgroundBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="{Binding Title}"
                       Background="{ThemeResource BackgroundBrush}">
      <utu:NavigationBar.MainCommand>
        <AppBarButton Label="Board"
                      AutomationProperties.Name="Back to the board">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Back" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <muxc:InfoBar Grid.Row="1"
                  Severity="Error"
                  Title="Not saved"
                  Message="{Binding SaveError}"
                  IsOpen="{Binding HasSaveError}"
                  IsClosable="False"
                  Margin="16,0">
      <muxc:InfoBar.ActionButton>
        <Button Content="Dismiss" Command="{Binding DismissError}" />
      </muxc:InfoBar.ActionButton>
    </muxc:InfoBar>

    <mvux:FeedView x:Name="CaseFeed"
                   Grid.Row="2"
                   Source="{Binding Case}"
                   RefreshingState="None"
                   VerticalContentAlignment="Stretch"
                   HorizontalContentAlignment="Stretch"
                   IsTabStop="False">
      <mvux:FeedView.ValueTemplate>
        <DataTemplate>
          <Grid uen:Region.Attached="True">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Tab row with the running clock on the right while the patient is asleep. -->
            <Grid BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,0,0,1" Padding="{utu:Responsive Narrow='8,0', Wide='24,0'}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <utu:TabBar Style="{StaticResource TopTabBarStyle}"
                          uen:Region.Attached="True"
                          SelectedIndex="{Binding Parent.Tab, Mode=TwoWay}"
                          Background="Transparent"
                          AutomationProperties.Name="Record sections">
                <utu:TabBarItem Content="Pre-op" uen:Region.Name="Preop" />
                <utu:TabBarItem Content="Drugs" uen:Region.Name="Drugs" />
                <utu:TabBarItem Content="Monitor" uen:Region.Name="Monitor" />
                <utu:TabBarItem Content="Recovery" uen:Region.Name="Recovery" />
              </utu:TabBar>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="12"
                          VerticalAlignment="Center"
                          Visibility="{Binding Data.IsAnesthetized}">
                <TextBlock Style="{StaticResource CodeTextStyle}"
                           Foreground="{ThemeResource OnSurfaceBrush}"
                           Text="{Binding Data.Elapsed}"
                           AutomationProperties.Name="Elapsed anesthesia time" />
                <TextBlock Style="{StaticResource CodeTextStyle}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           Visibility="{utu:Responsive Narrowest=Collapsed, Normal=Visible}">
                  <Run Text="next" />
                  <Run Text="{Binding Data.NextText}" />
                </TextBlock>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1" uen:Region.Attached="True" uen:Region.Navigator="Visibility">

              <!-- PRE-OP: anchor is the patient weight (every dose depends on it). -->
              <ScrollViewer uen:Region.Name="Preop" Visibility="Collapsed">
                <StackPanel Padding="{utu:Responsive Narrow='16,16,16,32', Wide='32,24,32,40'}" Spacing="24" MaxWidth="960" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="WEIGHT" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Style="{StaticResource DisplayLarge}"
                                 Foreground="{ThemeResource OnBackgroundBrush}"
                                 Text="{Binding Data.WeightText}"
                                 AutomationProperties.Name="Patient weight in kilograms" />
                      <TextBlock Style="{StaticResource HeadlineMedium}"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,10"
                                 Text="kg" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{Binding Data.Signalment}" />
                  </StackPanel>

                  <utu:CardContentControl Style="{StaticResource OutlinedCardContentControlStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
                    <StackPanel Padding="20" Spacing="8">
                      <Grid>
                        <TextBlock Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" Text="Pre-anesthetic check" />
                        <TextBlock Style="{StaticResource CodeTextStyle}"
                                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="{Binding Data.PreopProgress}" />
                      </Grid>
                      <CheckBox Content="Fasted (food withheld per protocol)"
                                IsEnabled="{Binding Data.IsScheduled}"
                                IsChecked="{Binding Parent.Preop.Fasted, Mode=TwoWay}" />
                      <CheckBox Content="IV catheter placed and flushed"
                                IsEnabled="{Binding Data.IsScheduled}"
                                IsChecked="{Binding Parent.Preop.IvCatheter, Mode=TwoWay}" />
                      <CheckBox Content="Anesthesia machine and circuit leak-checked"
                                IsEnabled="{Binding Data.IsScheduled}"
                                IsChecked="{Binding Parent.Preop.MachineChecked, Mode=TwoWay}" />
                      <CheckBox Content="Owner consent signed"
                                IsEnabled="{Binding Data.IsScheduled}"
                                IsChecked="{Binding Parent.Preop.ConsentSigned, Mode=TwoWay}" />
                      <CheckBox Content="Pre-anesthetic bloodwork reviewed"
                                IsEnabled="{Binding Data.IsScheduled}"
                                IsChecked="{Binding Parent.Preop.BloodworkReviewed, Mode=TwoWay}" />
                    </StackPanel>
                  </utu:CardContentControl>

                  <utu:CardContentControl Style="{StaticResource OutlinedCardContentControlStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
                    <StackPanel Padding="20" Spacing="12">
                      <TextBlock Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" Text="ASA physical status" />
                      <muxc:RadioButtons MaxColumns="6"
                                         IsEnabled="{Binding Data.IsScheduled}"
                                         SelectedIndex="{Binding Parent.Preop.Asa, Mode=TwoWay}"
                                         AutomationProperties.Name="ASA physical status">
                        <x:String>Not set</x:String>
                        <x:String>I</x:String>
                        <x:String>II</x:String>
                        <x:String>III</x:String>
                        <x:String>IV</x:String>
                        <x:String>V</x:String>
                      </muxc:RadioButtons>
                      <CheckBox Content="E: emergency procedure"
                                IsEnabled="{Binding Data.IsScheduled}"
                                IsChecked="{Binding Parent.Preop.AsaEmergency, Mode=TwoWay}" />
                      <TextBox Header="Notes"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               MinHeight="80"
                               IsEnabled="{Binding Data.IsScheduled}"
                               Text="{Binding Parent.Preop.Notes, Mode=TwoWay}" />
                    </StackPanel>
                  </utu:CardContentControl>

                  <StackPanel Spacing="8">
                    <Button Style="{StaticResource FilledButtonStyle}"
                            HorizontalAlignment="Left"
                            MinWidth="220"
                            Content="Induce"
                            Visibility="{Binding Data.IsScheduled}"
                            IsEnabled="{Binding Data.CanInduce}"
                            Command="{Binding Parent.Induce}"
                            AutomationProperties.Name="Induce anesthesia" />
                    <TextBlock Style="{StaticResource BodySmall}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                               Visibility="{Binding Data.IsScheduled}"
                               Text="Complete the five checks and set the ASA status to induce. Induction starts the reading clock." />
                    <TextBlock Style="{StaticResource TitleMedium}"
                               Foreground="{ThemeResource OnBackgroundBrush}"
                               Text="{Binding Data.InducedText}" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>

              <!-- DRUGS -->
              <ScrollViewer uen:Region.Name="Drugs" Visibility="Collapsed">
                <StackPanel Padding="{utu:Responsive Narrow='16,16,16,32', Wide='32,24,32,40'}" Spacing="16" MaxWidth="960" HorizontalAlignment="Stretch">
                  <TextBlock Style="{StaticResource HeadlineMedium}" Foreground="{ThemeResource OnBackgroundBrush}" Text="Doses given" />
                  <ItemsControl ItemsSource="{Binding Data.Doses}" AutomationProperties.Name="Doses given">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:DoseRow">
                        <Grid Padding="0,10" ColumnSpacing="16" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,0,0,1">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Style="{StaticResource CodeTextStyle}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{x:Bind Time}" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" Text="{x:Bind Drug}" />
                            <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}">
                              <Run Text="{x:Bind Dose}" />
                              <Run Text="·" />
                              <Run Text="{x:Bind Route}" />
                              <Run Text="{x:Bind Flag}" Foreground="{ThemeResource ErrorBrush}" />
                            </TextBlock>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Style="{StaticResource CodeTextStyle}" Foreground="{ThemeResource OnSurfaceBrush}" Text="{x:Bind Volume}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>

              <!-- MONITOR: the strip (at least 40 %) beside the pad on wide, above it on narrow. -->
              <ScrollViewer uen:Region.Name="Monitor" Visibility="Collapsed">
                <Grid Padding="{utu:Responsive Narrow='12,12,12,24', Wide='24,16,24,24'}" ColumnSpacing="20" RowSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="4*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <utu:CardContentControl Grid.ColumnSpan="{utu:Responsive Narrowest=2, Widest=1}"
                                          Style="{StaticResource OutlinedCardContentControlStyle}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Top"
                                          IsTabStop="False">
                    <Grid Padding="16" RowSpacing="8">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid>
                        <StackPanel Spacing="2">
                          <TextBlock Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" Text="Five-minute strip" />
                          <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{Binding Data.LastRecorded}" />
                        </StackPanel>
                        <!-- A filter chip: Material's default ToggleButton is an icon toggle that blanks its text when checked. -->
                        <utu:Chip HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource FilterChipStyle}"
                                  CanRemove="False"
                                  Content="Table"
                                  IsChecked="{Binding Parent.ShowTable, Mode=TwoWay}"
                                  AutomationProperties.Name="Show readings as a table" />
                      </Grid>
                      <controls:VitalsStrip Grid.Row="1"
                                            Height="{utu:Responsive Narrowest=300, Widest=440}"
                                            Data="{Binding Data.Strip}"
                                            Visibility="{Binding Parent.ShowStrip}"
                                            AutomationProperties.Name="{Binding Data.StripSummary}" />
                      <!-- Same footprint as the strip, so the pad below never moves when the table is on. -->
                      <ScrollViewer Grid.Row="1"
                                    Height="{utu:Responsive Narrowest=300, Widest=440}"
                                    Visibility="{Binding Parent.ShowTable}">
                      <ItemsControl ItemsSource="{Binding Data.Readings}"
                                    AutomationProperties.Name="Readings table">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:ReadingRow">
                            <Grid Padding="0,8" ColumnSpacing="12" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,0,0,1">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Style="{StaticResource CodeTextStyle}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{x:Bind Time}" />
                              <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Style="{StaticResource CodeTextStyle}" Foreground="{ThemeResource OnSurfaceBrush}" TextWrapping="Wrap">
                                  <Run Text="HR" /> <Run Text="{x:Bind Hr}" />
                                  <Run Text=" RR" /> <Run Text="{x:Bind Rr}" />
                                  <Run Text=" SpO₂" /> <Run Text="{x:Bind SpO2}" />
                                  <Run Text=" BP" /> <Run Text="{x:Bind Bp}" />
                                  <Run Text=" MAP" /> <Run Text="{x:Bind Map}" />
                                  <Run Text=" EtCO₂" /> <Run Text="{x:Bind EtCo2}" />
                                  <Run Text=" T" /> <Run Text="{x:Bind Temp}" />
                                  <Run Text=" " /> <Run Text="{x:Bind Plane}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource LabelLarge}" Foreground="{ThemeResource ErrorBrush}" Text="{x:Bind Alarms}" />
                                <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{x:Bind Note}" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      </ScrollViewer>
                    </Grid>
                  </utu:CardContentControl>

                  <!-- The pad: pre-filled from the last reading; an unchanged patient is one tap on Record. -->
                  <StackPanel Grid.Row="{utu:Responsive Narrowest=1, Widest=0}"
                              Grid.Column="{utu:Responsive Narrowest=0, Widest=1}"
                              Grid.ColumnSpan="{utu:Responsive Narrowest=2, Widest=1}"
                              Spacing="16">
                    <Button Style="{StaticResource FilledButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="64"
                            IsEnabled="{Binding Data.IsAnesthetized}"
                            Command="{Binding Parent.RecordReading}"
                            AutomationProperties.Name="Record reading">
                      <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="R" />
                      </Button.KeyboardAccelerators>
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <SymbolIcon Symbol="Accept" />
                        <TextBlock Text="Record reading" />
                        <TextBlock Style="{StaticResource CodeTextStyle}" Text="{Binding Data.NextText}" />
                      </StackPanel>
                    </Button>
                    <Grid ColumnSpacing="{utu:Responsive Narrowest=8, Normal=16}" RowSpacing="16">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                        <controls:VitalStepper Grid.Row="0" Grid.Column="0" Field="Hr" Label="HR" Unit="bpm" Glyph="●" GlyphBrush="{ThemeResource VitalHrBrush}"
                                               SpokenName="heart rate, beats per minute"
                                               Text="{Binding Parent.Draft.Hr, Mode=TwoWay}" Flag="{Binding Parent.Flags.Hr}"
                                               Command="{Binding Parent.Step}" />
                        <controls:VitalStepper Grid.Row="0" Grid.Column="1" Field="Rr" Label="RR" Unit="/min" Glyph="" GlyphBrush="{ThemeResource OnSurfaceVariantBrush}"
                                               SpokenName="respiratory rate, breaths per minute"
                                               Text="{Binding Parent.Draft.Rr, Mode=TwoWay}" Flag="{Binding Parent.Flags.Rr}"
                                               Command="{Binding Parent.Step}" />
                        <controls:VitalStepper Grid.Row="1" Grid.Column="0" Field="SpO2" Label="SpO₂" Unit="%" Glyph="○" GlyphBrush="{ThemeResource VitalSpO2Brush}"
                                               SpokenName="oxygen saturation, percent"
                                               Text="{Binding Parent.Draft.SpO2, Mode=TwoWay}" Flag="{Binding Parent.Flags.SpO2}"
                                               Command="{Binding Parent.Step}" />
                        <controls:VitalStepper Grid.Row="1" Grid.Column="1" Field="EtCo2" Label="EtCO₂" Unit="mmHg" Glyph="×" GlyphBrush="{ThemeResource VitalEtCo2Brush}"
                                               SpokenName="end-tidal CO2, millimetres of mercury"
                                               Text="{Binding Parent.Draft.EtCo2, Mode=TwoWay}" Flag="{Binding Parent.Flags.EtCo2}"
                                               Command="{Binding Parent.Step}" />
                        <controls:VitalStepper Grid.Row="2" Grid.Column="0" Field="Sys" Label="SYS" Unit="mmHg" Glyph="∨" GlyphBrush="{ThemeResource VitalBpBrush}"
                                               SpokenName="systolic pressure"
                                               Text="{Binding Parent.Draft.Sys, Mode=TwoWay}" Flag="{Binding Parent.Flags.Sys}"
                                               Command="{Binding Parent.Step}" />
                        <controls:VitalStepper Grid.Row="2" Grid.Column="1" Field="Dia" Label="DIA" Unit="mmHg" Glyph="∧" GlyphBrush="{ThemeResource VitalBpBrush}"
                                               SpokenName="diastolic pressure"
                                               Text="{Binding Parent.Draft.Dia, Mode=TwoWay}" Flag="{Binding Parent.Flags.Dia}"
                                               Command="{Binding Parent.Step}" />
                        <controls:VitalStepper Grid.Row="3" Grid.Column="0" Field="Map" Label="MAP" Unit="mmHg" Glyph="" GlyphBrush="{ThemeResource OnSurfaceVariantBrush}"
                                               SpokenName="mean arterial pressure"
                                               Text="{Binding Parent.Draft.Map, Mode=TwoWay}" Flag="{Binding Parent.Flags.Map}"
                                               Command="{Binding Parent.Step}" />
                        <controls:VitalStepper Grid.Row="3" Grid.Column="1" Field="TempC" Label="Temp" Unit="°C" Glyph="■" GlyphBrush="{ThemeResource VitalTempBrush}"
                                               SpokenName="temperature, degrees Celsius"
                                               Text="{Binding Parent.Draft.TempC, Mode=TwoWay}" Flag="{Binding Parent.Flags.TempC}"
                                               Command="{Binding Parent.Step}" />
                        <controls:VitalStepper Grid.Row="4" Grid.Column="0" Field="Vaporizer" Label="Sevo" Unit="%" Glyph="" GlyphBrush="{ThemeResource OnSurfaceVariantBrush}"
                                               SpokenName="vaporizer setting, percent"
                                               Text="{Binding Parent.Draft.Vaporizer, Mode=TwoWay}" 
                                               Command="{Binding Parent.Step}" />
                        <controls:VitalStepper Grid.Row="4" Grid.Column="1" Field="O2" Label="O₂" Unit="L/min" Glyph="" GlyphBrush="{ThemeResource OnSurfaceVariantBrush}"
                                               SpokenName="oxygen flow, litres per minute"
                                               Text="{Binding Parent.Draft.O2, Mode=TwoWay}" 
                                               Command="{Binding Parent.Step}" />
                    </Grid>
                    <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords">
                      <Run Text="MAP left blank is derived as (SYS + 2·DIA) / 3:" />
                      <Run Text="{Binding Parent.Flags.MapHint}" />
                    </TextBlock>
                    <muxc:RadioButtons Header="Anesthetic plane"
                                       MaxColumns="3"
                                       SelectedIndex="{Binding Parent.Draft.PlaneIndex, Mode=TwoWay}">
                      <x:String>Light</x:String>
                      <x:String>Surgical</x:String>
                      <x:String>Deep</x:String>
                    </muxc:RadioButtons>
                    <TextBox Header="Note (optional)"
                             Text="{Binding Parent.Draft.Note, Mode=TwoWay}"
                             AutomationProperties.Name="Note for this reading" />
                  </StackPanel>
                </Grid>
              </ScrollViewer>

              <!-- RECOVERY -->
              <ScrollViewer uen:Region.Name="Recovery" Visibility="Collapsed">
                <StackPanel Padding="{utu:Responsive Narrow='16,16,16,32', Wide='32,24,32,40'}" Spacing="16" MaxWidth="960" HorizontalAlignment="Stretch">
                  <TextBlock Style="{StaticResource HeadlineMedium}" Foreground="{ThemeResource OnBackgroundBrush}" Text="{Binding Data.StatusText}" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </DataTemplate>
      </mvux:FeedView.ValueTemplate>

      <mvux:FeedView.ProgressTemplate>
        <DataTemplate>
          <StackPanel Padding="32,24" Spacing="16">
            <Rectangle Width="360" Height="40" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
            <Rectangle Width="160" Height="64" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
            <Rectangle Height="220" RadiusX="12" RadiusY="12" Fill="{ThemeResource SurfaceVariantBrush}" />
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.ProgressTemplate>

      <mvux:FeedView.NoneTemplate>
        <DataTemplate>
          <StackPanel Padding="32,24" Spacing="12" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnBackgroundBrush}" Text="This record no longer exists." />
            <TextBlock Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="It may have been cleared from this device." />
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.NoneTemplate>

      <mvux:FeedView.ErrorTemplate>
        <DataTemplate>
          <StackPanel Padding="32,24" Spacing="12" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE783;" FontSize="20" Foreground="{ThemeResource ErrorBrush}" />
              <TextBlock Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnBackgroundBrush}" Text="Couldn't read this record." />
            </StackPanel>
            <TextBlock Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" Text="{Binding Message}" />
            <Button Style="{StaticResource OutlinedButtonStyle}"
                    HorizontalAlignment="Left"
                    Content="Retry"
                    AutomationProperties.Name="Retry reading the record"
                    Command="{Binding DataContext.Retry, ElementName=CaseFeed}" />
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.ErrorTemplate>
    </mvux:FeedView>
  </Grid>
</Page>
