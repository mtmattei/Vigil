<UserControl x:Class="Vigil.Controls.VitalStepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI"
             x:Name="Root">
  <!-- One vital on the pad: label with its strip glyph, 64 px − / value / + for gloved taps, range flag as text. -->
  <Grid RowSpacing="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6">
      <TextBlock Style="{StaticResource LabelLarge}"
                 Foreground="{Binding GlyphBrush, ElementName=Root}"
                 Text="{Binding Glyph, ElementName=Root}" />
      <TextBlock Style="{StaticResource LabelLarge}"
                 Foreground="{ThemeResource OnSurfaceBrush}"
                 Text="{Binding Label, ElementName=Root}" />
      <TextBlock Style="{StaticResource LabelMedium}"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}"
                 VerticalAlignment="Bottom"
                 Text="{Binding Unit, ElementName=Root}" />
      <TextBlock Style="{StaticResource LabelLarge}"
                 Foreground="{ThemeResource ErrorBrush}"
                 Text="{Binding Flag, ElementName=Root}"
                 AutomationProperties.LiveSetting="Polite" />
    </StackPanel>

    <RepeatButton Grid.Row="1"
                  Width="{utu:Responsive Narrowest=56, Normal=64}"
                  Height="64"
                  Padding="0"
                  Delay="400"
                  Interval="120"
                  Style="{StaticResource OutlinedButtonStyle}"
                  Command="{Binding Command, ElementName=Root}"
                  CommandParameter="{Binding DecrementParameter, ElementName=Root}"
                  AutomationProperties.Name="{Binding DecrementName, ElementName=Root}">
      <SymbolIcon Symbol="Remove" />
    </RepeatButton>
    <TextBox Grid.Row="1"
             Grid.Column="1"
             Margin="{utu:Responsive Narrowest='4,0', Normal='8,0'}"
             MinHeight="64"
             TextAlignment="Center"
             VerticalContentAlignment="Center"
             FontFamily="{StaticResource HeadlineSmallFontFamily}"
             FontSize="{StaticResource HeadlineMediumFontSize}"
             InputScope="Number"
             Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             AutomationProperties.Name="{Binding AccessibleName, ElementName=Root}" />
    <RepeatButton Grid.Row="1"
                  Grid.Column="2"
                  Width="{utu:Responsive Narrowest=56, Normal=64}"
                  Height="64"
                  Padding="0"
                  Delay="400"
                  Interval="120"
                  Style="{StaticResource OutlinedButtonStyle}"
                  Command="{Binding Command, ElementName=Root}"
                  CommandParameter="{Binding IncrementParameter, ElementName=Root}"
                  AutomationProperties.Name="{Binding IncrementName, ElementName=Root}">
      <SymbolIcon Symbol="Add" />
    </RepeatButton>
  </Grid>
</UserControl>
