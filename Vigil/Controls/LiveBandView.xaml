<UserControl x:Class="Vigil.Controls.LiveBandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uen="using:Uno.Extensions.Navigation.UI"
             xmlns:utu="using:Uno.Toolkit.UI"
             utu:VisualStateManagerExtensions.States="{Binding DueStateName}">
  <!-- The board's live band. DataContext: LiveCase. Due states driven by LiveCase.DueStateName. -->
  <Grid>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="DueStates">
        <VisualState x:Name="Waiting" />
        <VisualState x:Name="None" />
        <VisualState x:Name="Due">
          <VisualState.Setters>
            <Setter Target="NextText.Foreground" Value="{ThemeResource PrimaryBrush}" />
            <Setter Target="DueIcon.Visibility" Value="Visible" />
            <Setter Target="DueIcon.Glyph" Value="&#xE916;" />
            <Setter Target="DueIcon.Foreground" Value="{ThemeResource PrimaryBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Overdue">
          <VisualState.Setters>
            <Setter Target="NextText.Foreground" Value="{ThemeResource ErrorBrush}" />
            <Setter Target="NextLabel.Foreground" Value="{ThemeResource ErrorBrush}" />
            <Setter Target="DueIcon.Visibility" Value="Visible" />
            <Setter Target="DueIcon.Glyph" Value="&#xE7BA;" />
            <Setter Target="DueIcon.Foreground" Value="{ThemeResource ErrorBrush}" />
            <Setter Target="DueBar.Foreground" Value="{ThemeResource ErrorBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- States is set on the UserControl; the groups live on its first child (Toolkit doc contract). -->
    <Button x:Uid="LiveBand_1"
            Style="{StaticResource TextButtonStyle}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Padding="{utu:Responsive Narrow='16,16', Wide='32,20'}"
            CornerRadius="0"
            uen:Navigation.Request="Record"
            uen:Navigation.Data="{Binding}"
            AutomationProperties.Name="Open the live record">
      <Grid ColumnSpacing="24" RowSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
          <TextBlock x:Uid="LiveBand_2" Style="{StaticResource LabelLarge}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     Text="UNDER ANESTHESIA" />
          <TextBlock Style="{StaticResource TitleLarge}"
                     Foreground="{ThemeResource OnSurfaceBrush}"
                     TextTrimming="CharacterEllipsis">
            <Run Text="{Binding Name}" />
            <Run Text="·" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            <Run Text="{Binding Procedure}" />
          </TextBlock>
          <TextBlock Style="{StaticResource BodySmall}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     Text="{Binding Band}" />
        <TextBlock Style="{StaticResource LabelLarge}"
                   Foreground="{ThemeResource PrimaryBrush}"
                   Visibility="{Binding HasOthers}"
                   Text="{Binding Others}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
          <TextBlock x:Uid="LiveBand_3" Style="{StaticResource DisplayLarge}"
                     Foreground="{ThemeResource OnSurfaceBrush}"
                     Text="{Binding Elapsed}"
                     AutomationProperties.Name="Elapsed anesthesia time" />
          <TextBlock x:Uid="LiveBand_4" Style="{StaticResource BodySmall}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,12"
                     Text="elapsed" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,8"
                    Spacing="4">
          <TextBlock x:Name="NextLabel"
                     Style="{StaticResource LabelLarge}"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     HorizontalAlignment="Right"
                     Text="{Binding NextLabel}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <FontIcon x:Name="DueIcon"
                      Visibility="Collapsed"
                      FontSize="24"
                      Glyph="&#xE916;" />
            <TextBlock x:Name="NextText"
                       Style="{StaticResource HeadlineLarge}"
                       Foreground="{ThemeResource OnSurfaceBrush}"
                       Text="{Binding NextText}" />
          </StackPanel>
        </StackPanel>

        <!-- The due slot as a sight glass: fills from the last reading to the next one. -->
        <ProgressBar x:Uid="LiveBand_5" x:Name="DueBar"
                     Grid.Row="2"
                     Grid.ColumnSpan="2"
                     Minimum="0"
                     Maximum="100"
                     MinHeight="6"
                     Background="{ThemeResource OutlineBrush}"
                     Value="{Binding ProgressPercent}"
                     AutomationProperties.Name="Time until the next reading" />
        <TextBlock Grid.Row="3"
                   Grid.ColumnSpan="2"
                   Margin="0,4,0,0"
                   Style="{StaticResource CodeTextStyle}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   Visibility="{utu:Responsive Narrowest=Collapsed, Normal=Visible}"
                   Text="{Binding LastReading}" />
      </Grid>
    </Button>
  </Grid>
</UserControl>
