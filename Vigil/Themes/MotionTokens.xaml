<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Motion vocabulary (SPEC Design Brief): two curves, three durations. No Forever storyboards. -->
  <x:String x:Key="EaseSmoothSpline">0.22,1 0.36,1</x:String>
  <x:String x:Key="EaseOutSpline">0.17,1 0.32,1</x:String>
  <Duration x:Key="DurationFast">0:0:0.15</Duration>
  <Duration x:Key="DurationNormal">0:0:0.2</Duration>
  <Duration x:Key="DurationSlow">0:0:0.28</Duration>
  <x:Double x:Key="EntranceRise">6</x:Double>
  <x:Double x:Key="PressScale">0.98</x:Double>
</ResourceDictionary>
