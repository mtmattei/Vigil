<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utu="using:Uno.Toolkit.UI">
  <!--
    App-wide lightweight-styling keys (rung 2). Gloved taps: every button is 56 px tall.
    Cards are outlined with the border colour at radius 12; shadows only on the floating Record button.
  -->
  <x:Double x:Key="ButtonHeight">56</x:Double>
  <x:Double x:Key="ButtonMinHeight">56</x:Double>
  <CornerRadius x:Key="ButtonCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>

  <!--
    WORKAROUND(CardContentControl washes out after a touch swipe): the Material card templates keep their
    pressed overlay when a swipe that starts on the card is taken by the ScrollViewer (measured here on the
    Android emulator, Toolkit 9.1.3: the Settings "Monitoring" card stayed greyed). Static cards draw only
    their surface and outline; tappable cards keep the stock template.
    xaml-lint: allow template - see WORKAROUND
  -->
  <Style x:Key="StaticOutlinedCardStyle"
         TargetType="utu:CardContentControl"
         BasedOn="{StaticResource OutlinedCardContentControlStyle}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="utu:CardContentControl">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
