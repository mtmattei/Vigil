<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    App-wide lightweight-styling keys (rung 2). Gloved taps: every button is 56 px tall.
    Cards are outlined with the border colour at radius 12; shadows only on the floating Record button.
  -->
  <x:Double x:Key="ButtonHeight">56</x:Double>
  <x:Double x:Key="ButtonMinHeight">56</x:Double>
  <CornerRadius x:Key="ButtonCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
</ResourceDictionary>
